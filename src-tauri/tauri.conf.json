{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LazySheet",
  "version": "0.4.0",
  "identifier": "id.edot.lazysheet",
  "build": {
    "beforeDevCommand": "deno run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "deno run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LazySheet",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 17 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["xlsx"],
        "name": "Excel Workbook",
        "description": "Microsoft Excel Open XML Spreadsheet",
        "role": "Viewer",
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
      },
      {
        "ext": ["xlsm"],
        "name": "Excel Macro-Enabled Workbook",
        "description": "Microsoft Excel Macro-Enabled Spreadsheet",
        "role": "Viewer"
      },
      {
        "ext": ["xls"],
        "name": "Excel 97-2003 Workbook",
        "description": "Microsoft Excel Legacy Spreadsheet",
        "role": "Viewer",
        "mimeType": "application/vnd.ms-excel"
      },
      {
        "ext": ["csv"],
        "name": "CSV Document",
        "description": "Comma-Separated Values",
        "role": "Viewer",
        "mimeType": "text/csv"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/triasbrata/lazysheet/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyQzFBREE0OUVGODJGNTMKUldSVEwvaWVwSzNCMGdmeEJNbjlvNVF1T0ZBMmxGbklXdGJoTjBodzZWc3hjaXl0bW5QQk9zSEMK"
    }
  }
}
