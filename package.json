{
  "name": "lazysheet",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "tauri build",
    "build:web": "tsc && bun run scripts/build.ts",
    "preview": "bun run scripts/dev.ts --preview",
    "tauri": "tauri",
    "run:dev": "tauri dev",
    "test": "bun test --isolate src --coverage && bun run scripts/coverage-total.ts",
    "test:watch": "bun test --isolate src --watch",
    "test:coverage": "bun test --isolate src --coverage",
    "app:deploy": "bun run scripts/deploy.ts",
    "e2e:fixtures": "bun run e2e/fixtures/generate.ts",
    "e2e:build-app": "VITE_E2E=true VITE_FF_MULTI_LANG=true bun run build:web && cargo build --manifest-path src-tauri/Cargo.toml --features webdriver",
    "e2e:dev:web": "VITE_E2E=true bun run scripts/dev.ts",
    "e2e:dev:build-app": "cargo build --manifest-path src-tauri/Cargo.toml --features webdriver-dev",
    "e2e:run": "cd e2e && bun run test",
    "e2e:full:run": "bun run e2e:build-app && bun run e2e:run",
    "test:e2e": "bun run scripts/e2e.ts"
  },
  "dependencies": {
    "@crabnebula/tauri-plugin-drag": "^2",
    "@fontsource-variable/geist": "^5.2.9",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "i18next": "^25.0.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.0.0",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tauri-plugin-clipboard-api": "^2.1.11",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@happy-dom/global-registrator": "^20.10.1",
    "@sinonjs/fake-timers": "^15.4.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "latest",
    "@types/node": "^25.9.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/sinonjs__fake-timers": "^15.0.1",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-istanbul": "^3.0.0",
    "@vitest/coverage-v8": "^3.2.6",
    "babel-plugin-istanbul": "^8.0.0",
    "bun-plugin-tailwind": "^0.1.2",
    "dotenv": "^17.4.2",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-istanbul": "^7.0.0",
    "vitest": "^3.0.0",
    "xlsx": "^0.18.5"
  }
}
