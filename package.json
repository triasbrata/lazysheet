{
  "name": "lazysheet",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tauri build",
    "build:web": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "run:dev": "tauri dev",
    "test": "vitest run --coverage && bun run scripts/coverage-total.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "app:deploy": "bun run scripts/deploy.ts",
    "e2e:fixtures": "bun run e2e/fixtures/generate.ts",
    "e2e:build-app": "VITE_E2E=true VITE_FF_MULTI_LANG=true bun run build:web && cargo build --manifest-path src-tauri/Cargo.toml --features webdriver",
    "e2e:dev:vite": "VITE_E2E=true vite",
    "e2e:dev:build-app": "cargo build --manifest-path src-tauri/Cargo.toml --features webdriver-dev",
    "e2e:run": "cd e2e && bun run test",
    "e2e:full:run": "bun run e2e:build-app && bun run e2e:run",
    "test:e2e": "bun run scripts/e2e.ts"
  },
  "dependencies": {
    "@crabnebula/tauri-plugin-drag": "^2",
    "@fontsource-variable/geist": "^5.2.9",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "i18next": "^25.0.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.0.0",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tauri-plugin-clipboard-api": "^2.1.11",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.6",
    "dotenv": "^17.4.2",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.0.0",
    "xlsx": "^0.18.5",
    "vite-plugin-istanbul": "^7.0.0",
    "@vitest/coverage-istanbul": "^3.0.0",
    "@types/bun": "latest"
  }
}
